# Case 2: ИИ-конвейер судебных документов
# Скопируй в .env и заполни своими значениями:
#     cp .env.example .env

# ================================================================= #
# n8n — доступ                                                       #
# ================================================================= #
N8N_USER=admin
N8N_PASSWORD=changeme

# ================================================================= #
# Ollama — общий с Кейсом №1                                         #
# ================================================================= #
# URL Ollama, доступный из контейнера n8n через host.docker.internal
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b

# ================================================================= #
# rules-service — препроцессор + 7 зон контроля                      #
# ================================================================= #
# URL rules-service (задаётся в docker-compose.yml, здесь для справки):
# RULES_SERVICE_URL=http://rules-service:8001

# Порог HITL: сколько критичных issues достаточно для ручной проверки.
# 0 — любой FAIL требует HITL (рекомендуется).
# 1 — HITL только если 2+ зоны упали (более мягкий режим).
HITL_THRESHOLD=0

# ================================================================= #
# Юридические параметры (353-ФЗ)                                     #
# ================================================================= #

# Ставка по умолчанию (0.8 = 0.8% в день, максимум по 353-ФЗ, ч. 23 ст. 5).
DEFAULT_RATE=0.8

# Исковая давность (в годах, ст. 196 ГК РФ).
LIMITATION_YEARS=3

# 353-ФЗ, ч. 24 ст. 5: потолок переплаты (проценты + неустойка).
# 1.30 — до 01.04.2026
# 1.00 — с 01.04.2026 (актуально)
MAX_OVERPAYMENT_RATIO=1.00

# 353-ФЗ, ч. 21 ст. 5: неустойка (пени).
# Если проценты продолжают начисляться — потолок 20% годовых ≈ 0.055% в день.
# Если проценты не начисляются — потолок 0.1% в день.
PENALTY_DAILY_RATE=0.0005
PENALTY_MAX_DAILY_RATE=0.001

# ================================================================= #
# PDF                                                                #
# ================================================================= #
# Директория для сохранения PDF (внутри контейнера rules-service).
# На хосте — ./pdf-output/ (см. docker-compose.yml).
PDF_OUTPUT_DIR=/tmp/court-pdfs
