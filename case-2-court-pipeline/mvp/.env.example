# Case 2: ИИ-конвейер судебных документов
# Скопируй в .env и заполни своими значениями

# n8n — доступ
N8N_USER=admin
N8N_PASSWORD=changeme

# Ollama — общий с Кейсом №1
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b

# Препроцессор — параметры
# Коэффициент ставки по умолчанию (0.8 = 0.8% в день, максимум по 353-ФЗ)
DEFAULT_RATE=0.8

# Исковая давность (в годах, ст. 196 ГК РФ)
LIMITATION_YEARS=3

# 353-ФЗ, ч. 24 ст. 5: потолок переплаты (проценты + неустойка)
# 1.30 — до 01.04.2026
# 1.00 — с 01.04.2026
MAX_OVERPAYMENT_RATIO=1.00

# 353-ФЗ, ч. 21 ст. 5: неустойка (пени)
# Если проценты продолжают начисляться — потолок 20% годовых ≈ 0.055% в день.
# Если проценты не начисляются — потолок 0.1% в день.
# Значение ниже — рабочая ставка (клиент может понизить, но не выше потолка).
PENALTY_DAILY_RATE=0.0005

# Абсолютный потолок неустойки (0.1% в день по 353-ФЗ).
# Используется для валидации PENALTY_DAILY_RATE в препроцессоре.
PENALTY_MAX_DAILY_RATE=0.001

# HITL — порог для автоматической отправки на проверку
# Если critical_issues > 0 → HITL обязателен
HITL_THRESHOLD=0

# PDF — путь для сохранения
PDF_OUTPUT_DIR=/tmp/court-pdfs
