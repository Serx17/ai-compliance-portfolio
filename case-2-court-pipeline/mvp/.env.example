# Case 2: ИИ-конвейер судебных документов
# Скопируй в .env и заполни своими значениями

# n8n — доступ
N8N_USER=admin
N8N_PASSWORD=changeme

# Ollama — общий с Кейсом №1
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b

# Препроцессор — параметры
# Коэффициент ставки по умолчанию (0.8 = 0.8% в день по 230-ФЗ)
DEFAULT_RATE=0.8

# Исковая давность (в годах, ст. 196 ГК РФ)
LIMITATION_YEARS=3

# HITL — порог для автоматической отправки на проверку
# Если critical_issues > 0 → HITL обязателен
HITL_THRESHOLD=0

# PDF — путь для сохранения
PDF_OUTPUT_DIR=/tmp/court-pdfs
