    {
      "parameters": {
        "jsCode": "// Получаем транскрипт от ASR\nconst transcript = $input.first().json.text;\n\n// Промпт: ТОЛЬКО time_violation\nconst prompt = `Проанализируй текст звонка коллектора. Найди ТОЛЬКО нарушение по времени.\n\nНарушение времени = звонок вне разрешённого времени (до 8:00 или после 22:00 в рабочие дни; до 9:00 или после 20:00 в выходные).\n\nПризнаки: прямое упоминание времени в тексте (\"сейчас 22:15\", \"половина одиннадцатого\", \"вечер\", \"ночь\").\n\nВерни СТРОГО JSON без пояснений:\n{\n  \"found\": true или false,\n  \"quote\": \"точная цитата из текста, подтверждающая нарушение (или пустая строка)\",\n  \"confidence\": число от 0.0 до 1.0,\n  \"reasoning\": \"краткое объяснение\"\n}\n\nТЕКСТ ЗВОНКА:\n${transcript}`;\n\nreturn {\n  json: {\n    model: \"qwen2.5:7b\",\n    prompt: prompt,\n    stream: false,\n    options: {\n      temperature: 0.0,\n      top_p: 0.9\n    }\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
